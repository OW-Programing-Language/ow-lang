# Demonstrates runtime-sized arrays compiled with OW LLVM.
# Run with: ow run examples/native_dynamic_arrays.ow
# Compile with: ow llvm examples/native_dynamic_arrays.ow target/dynamic.ll
fn twice(value):
  return: value * 2

main:
  set count: 2 + 2
  set values: array(count, twice(3))
  print: len(values)
  print: values[0]

  set alias: values
  set values[3]: 42
  print: alias[3]

  set empty: array(0, 7)
  print: len(empty)
