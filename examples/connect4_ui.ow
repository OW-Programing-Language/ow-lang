# Connect 4 — modern clickable GUI, rendered in the browser by Ow's UI runtime.
# Run it (OwIDE "Run" or `owc --run connect4_ui.ow`); a window opens where you
# click a column to drop a piece. Same Board class as the console version.

class Board:
  field cells
  field rows
  field cols

  fn new():
    set this.rows: 6
    set this.cols: 7
    set this.cells: array(42, 0)

  fn idx(r, c):
    return: r * this.cols + c

  fn get(r, c):
    return: this.cells[this.idx(r, c)]

  fn put(r, c, v):
    set cells: this.cells
    set cells[this.idx(r, c)]: v

  fn drop(col, player):
    set r: this.rows - 1
    while: r >= 0
      if: this.get(r, col) == 0
        call: this.put(r, col, player)
        return: r
      set r: r - 1
    return: 0 - 1

  fn in_bounds(r, c):
    if: r < 0
      return: 0
    if: r >= this.rows
      return: 0
    if: c < 0
      return: 0
    if: c >= this.cols
      return: 0
    return: 1

  fn line(r, c, dr, dc):
    set v: this.get(r, c)
    if: v == 0
      return: 0
    set k: 1
    while: k < 4
      set rr: r + dr * k
      set cc: c + dc * k
      if: this.in_bounds(rr, cc) == 0
        return: 0
      if: this.get(rr, cc) != v
        return: 0
      set k: k + 1
    return: v

  fn winner():
    set r: 0
    while: r < this.rows
      set c: 0
      while: c < this.cols
        set w: this.line(r, c, 0, 1)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 0)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 1)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 0 - 1)
        if: w != 0
          return: w
        set c: c + 1
      set r: r + 1
    return: 0

  fn is_full():
    set c: 0
    while: c < this.cols
      if: this.get(0, c) == 0
        return: 0
      set c: c + 1
    return: 1

fn name(p):
  if: p == 1
    return: "Red"
  else:
    return: "Yellow"

fn other(p):
  if: p == 1
    return: 2
  else:
    return: 1

fn color_name(v):
  switch: v
    case 1:
      return: "red"
    case 2:
      return: "yellow"
    default:
      return: "empty"

fn drop_buttons():
  set btns: array(7, 0)
  set c int: 0
  while: c < 7
    set btns[c]: ui_button("" + (c + 1), "on_drop", c)
    set c: c + 1
  return: btns

fn disc_cells():
  set cells: array(42, 0)
  set i int: 0
  set r int: 0
  while: r < 6
    set c int: 0
    while: c < 7
      set cells[i]: ui_disc(color_name(board.get(r, c)))
      set i: i + 1
      set c: c + 1
    set r: r + 1
  return: cells

fn render():
  return: ui_col([ui_heading("Connect 4"), ui_text(status), ui_row(drop_buttons()), ui_grid(7, disc_cells()), ui_button("New game", "new_game")])

fn on_drop(col):
  if: winner_val != 0
    return: 0
  set landed int: board.drop(col, player)
  if: landed == 0 - 1
    return: 0
  set w int: board.winner()
  if: w != 0
    set winner_val: w
    set status: name(w) + " wins! 🎉"
  else:
    if: board.is_full() == 1
      set status: "It's a draw!"
    else:
      set player: other(player)
      set status: name(player) + "'s turn"
  return: 0

fn new_game():
  set board: new Board()
  set player: 1
  set winner_val: 0
  set status: "Red's turn — click a column"
  return: 0

main:
  set board: new Board()
  set player int: 1
  set winner_val int: 0
  set status string: "Red's turn — click a column"
  call: ui_run("render", "Connect 4 — Ow")
