# OCaml-style functor example: MakeSorter(ORDERED) -> SORTER.
# This uses OW's optional typed method signatures (OW interpreter upgrade).
# Same functor is applied to two different implementations of Ordered.
interface Ordered:
  fn compare(a int, b int) -> int

interface Sorter:
  fn smallest(a int, b int) -> int

interface SorterFunctor:
  fn make(order Ordered) -> Sorter

class Ascending(Ordered):
  fn compare(a int, b int) -> int:
    if: a < b
      return: -1
    if: a > b
      return: 1
    return: 0

class Descending(Ordered):
  fn compare(a int, b int) -> int:
    if: a > b
      return: -1
    if: a < b
      return: 1
    return: 0

class SorterImpl(Sorter):
  field ordering

  fn new(ordering Ordered):
    set this.ordering: ordering
    return: 0

  fn smallest(a int, b int) -> int:
    if: this.ordering.compare(a, b) < 1
      return: a
    return: b

class MakeSorter(SorterFunctor):
  fn make(order Ordered) -> Sorter:
    set result Sorter: new SorterImpl(order)
    return: result

main:
  set make: new MakeSorter()
  set ascending Sorter: make.make(new Ascending())
  set descending Sorter: make.make(new Descending())
  call: assert(ascending.smallest(2, 7) == 2, "ascending policy")
  call: assert(descending.smallest(2, 7) == 7, "descending policy")
  print: "PASS typed module functor: Ordered -> Sorter"
