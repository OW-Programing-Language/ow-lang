# Puissance 4 en Ow
# Limite actuelle du langage : pas d'entree utilisateur, pas de tableaux.
# Cette version montre donc une partie scriptée et detecte le gagnant.

fn mark(v):
  if: v == 0
    return: "."
  else:
    if: v == 1
      return: "X"
    else:
      return: "O"

fn row(a, b, c, d, e, f, g):
  return: mark(a) + " " + mark(b) + " " + mark(c) + " " + mark(d) + " " + mark(e) + " " + mark(f) + " " + mark(g)

fn four(a, b, c, d):
  if: a != 0
    if: a == b
      if: b == c
        if: c == d
          return: 1
  return: 0

fn player_name(v):
  if: v == 1
    return: "Joueur 1 (X)"
  else:
    if: v == 2
      return: "Joueur 2 (O)"
    else:
      return: "Personne"

