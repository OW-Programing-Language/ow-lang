module_type BOX:
  type token
  fn wrap(x int) -> token
  fn unwrap(x token) -> int
module A: BOX
  type token: int
  fn wrap(x int) -> token:
    return: x
  fn unwrap(x token) -> int:
    return: x
module B: BOX
  type token: int
  fn wrap(x int) -> token:
    return: x
  fn unwrap(x token) -> int:
    return: x
main:
  print: B.unwrap(A.wrap(3))
