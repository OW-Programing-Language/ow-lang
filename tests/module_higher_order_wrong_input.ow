module_type SOURCE:
  fn get() -> int
module_type RESULT:
  fn result() -> int
module_type OTHER:
  fn different() -> int
module Source: SOURCE
  fn get() -> int:
    return: 0
functor_type MAKER(SOURCE) -> RESULT
functor Wrong(S: SOURCE) -> OTHER:
  fn different() -> int:
    return: 1
functor Needs(F: MAKER) -> RESULT:
  fn result() -> int:
    return: 1
main:
  set bad: Needs(Wrong)
